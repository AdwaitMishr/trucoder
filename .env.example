# TruCoder environment configuration.
# Copy this file to `.env` and edit before first run.
#   cp .env.example .env

# The owner account is created on first boot (seeded into the DB).
# No registration — this is the single sign-in for your instance.
OWNER_USERNAME=admin
OWNER_PASSWORD=change-me-to-a-strong-password

# Secret used to sign session cookies. Generate one:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Optional overrides (uncomment to change) ---
# PORT=3001
# DATA_DIR=/absolute/path/to/data
# COURSES_DIR=/absolute/path/to/courses

# GitHub webhook secret for POST /_deploy (auto-deploy on push to main).
# Set the same value as the webhook secret in the repo settings.
DEPLOY_SECRET=
