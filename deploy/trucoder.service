[Unit]
Description=TruCoder - interactive coding course platform
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=adith
WorkingDirectory=/home/adith/trucoder/server
# /usr/bin/node (v24) matches the ABI that better-sqlite3 was compiled for.
# The Hermes login shell can resolve an nvm node instead — pin the binary.
ExecStart=/usr/bin/node /home/adith/trucoder/server/dist/index.js
EnvironmentFile=/home/adith/trucoder/.env
Environment=DATA_DIR=/home/adith/trucoder/data
Restart=on-failure
RestartSec=3
# NOTE: NoNewPrivileges stays OFF — the deploy webhook child runs `sudo
# systemctl restart` and the flag makes sudo fail with "no new privileges".
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
